exports[`run card renderer snapshots > collapses consecutive tools while preserving the latest running tool 1`] = `
{
  "body": {
    "elements": [
      {
        "columns": [
          {
            "elements": [
              {
                "content": "Running",
                "tag": "markdown",
                "text_size": "notation",
              },
            ],
            "tag": "column",
            "vertical_align": "center",
            "width": "auto",
          },
          {
            "elements": [
              {
                "icon": {
                  "img_key": "img_v3_02vb_496bec09-4b43-4773-ad6b-0cdd103cd2bg",
                  "size": "16px 16px",
                  "tag": "custom_icon",
                },
                "tag": "div",
                "text": {
                  "content": " ",
                  "tag": "plain_text",
                },
              },
            ],
            "tag": "column",
            "vertical_align": "center",
            "width": "auto",
          },
        ],
        "flex_mode": "none",
        "horizontal_spacing": "4px",
        "tag": "column_set",
      },
      {
        "border": {
          "color": "grey",
          "corner_radius": "5px",
        },
        "elements": [
          {
            "content": "- ⌨️ **Edit** — /repo/a.ts
- 📖 **Read** — /repo/a.ts
- 🖥️ **Bash** — pwd",
            "tag": "markdown",
            "text_size": "notation",
          },
        ],
        "expanded": false,
        "header": {
          "icon": {
            "size": "16px 16px",
            "tag": "standard_icon",
            "token": "down-small-ccm_outlined",
          },
          "icon_expanded_angle": -180,
          "icon_position": "right",
          "title": {
            "content": "💭 0 · 🛠️ 3",
            "tag": "markdown",
            "text_size": "notation",
          },
          "vertical_align": "center",
        },
        "padding": "6px 8px 6px 8px",
        "tag": "collapsible_panel",
        "vertical_spacing": "4px",
      },
    ],
  },
  "config": {
    "streaming_mode": true,
    "summary": {
      "content": "Running…",
    },
  },
  "schema": "2.0",
}
`;

